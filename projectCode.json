      "parameters": {
        "jsCode": "for (let item of $input.all()) {\n  let data = item.json.body;\n  let budget = parseInt(data.budget || 0);\n  let message = (data.message || '').toLowerCase();\n\n  let score = 0;\n\n  if (budget >= 50000) {\n    score += 50;\n  } else if (budget >= 10000) {\n    score += 20;\n  }\n\n  if (message.includes('commercial') || message.includes('asap')) {\n    score += 40;\n  }\n  item.json.lead_score = score;\n  item.json.is_vip_lead = score >= 80;\n}\n\nreturn $input.all();"
      },
